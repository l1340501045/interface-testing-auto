COMPOSE_PROJECT_NAME=interface-testing-auto-dev
WEB_PORT=15173
API_PORT=18080
POSTGRES_PASSWORD=
APP_RUNTIME_PASSWORD=
SECRET_KEY=
# 允许被测请求访问的来源白名单（scheme://host:port），逗号分隔。只列显式受控目标，
# 不放开任意 localhost 或私网；留空时使用 compose.yaml 中的默认受控目标服务。
CONTROLLED_TARGETS=http://echo:8080,http://echo-alt:8080
# 平台基础设施禁区（可信部署配置，逗号分隔）。主机名基线已包含 localhost、当前
# Compose 的 api／db／web／worker 与 host.docker.internal 等宿主机入口，这里只能
# 追加：普通项目的目标白名单覆盖不了禁区，把禁区地址填进白名单也不会被放行。
# 地址项：平台所在网段或单个地址（如 172.22.0.0/24、10.0.0.5）。填错不会让进程
# 静默放行：构造守卫时（创建运行或发送前复核）按配置错误报出。留空即只用基线名单。
PLATFORM_FORBIDDEN_HOSTS=
PLATFORM_FORBIDDEN_ADDRESSES=
# 当前部署**实际启用**、必须完整确认地址的基础设施来源（逗号分隔）。
# 每次发送前这些名字必须全部解析成功，否则这次发送被拒绝：解析失败就证明不了禁区
# 完整，而“解析不了就跳过”会让同 IP 的别名合法漏过去。只列你这次部署真的有的名字；
# 管理 API、数据库（api／db）与**容器到宿主机的入口**（host.docker.internal）由代码
# 基线无条件要求，这里写上只是为了自文档；此外 PGHOST 指向的数据库主机与
# PLATFORM_FORBIDDEN_HOSTS 声明的来源总是必需。宿主入口由 compose.yaml 的
# extra_hosts: host.docker.internal:host-gateway 提供（Linux 与 Docker Desktop 都解析到
# 宿主自己），不需要你去找宿主 IP；改用别的部署方式时，要么提供等价的宿主入口，要么用
# PLATFORM_FORBIDDEN_ADDRESSES 显式声明宿主的地址／网段——两者都没有时发送会被拒绝，
# 而不是少一层保护。
# **执行器**（worker，即它在 Compose 里的服务名）是部署可选的服务：本模板对应的安装
# 只用 make up 起平台本体、不启动 worker，验证流程在进程内跑同一份执行内核，所以这里
# 不含 worker——要求一个当前部署没有的名字解析成功，会把所有发送都拒掉（干净克隆的
# make check 会直接失败）。要真实执行用例时把它加进来，且必须在 make worker 之前：
# 执行器进程启动时会自查这条声明（缺了就拒绝启动），并确认宿主入口此刻解析得到，不会
# 出现“跑着执行器却不设防”。
# 其它平台的兼容别名（host.containers.internal、gateway.docker.internal、ip6-localhost
# 等）不必列：它们始终被静态拒绝，且并非每个平台都有，列上会让干净安装与 CI 直接失败。
# 本项是部署配置：用例、运行请求与项目白名单都改不动它，进程也不会为了“确认来源”向
# 任何地址发请求（只看名字解析）。
PLATFORM_REQUIRED_HOSTS=api,db,web
# 受控目标服务用于闭环验收的凭据。受控服务的 /secure/profile 会在服务端比对这个值，
# 返回认证结论与不可逆的指纹前缀，验收因此不必把秘密写进用例或运行报告。
# 只在本机 .env 里填写，不要提交真实值。
CONTROLLED_TARGET_TOKEN=
# 独立执行进程服务的执行池 id（逗号分隔）。不填则 worker 明确报错退出。
WORKER_POOL_IDS=
WORKER_ID=worker-1
